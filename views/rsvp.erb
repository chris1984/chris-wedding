<div class="container">
  <h1>RSVP</h1>
  <p style="font-family: 'Cormorant Garamond', serif; font-size: 20px; font-style: italic; color: #666; margin-top: 8px;">We look forward to celebrating with you</p>

  <div class="divider"></div>

  <style>
    .form-group {
      text-align: left;
      margin-bottom: 24px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 8px;
      color: #2C2C2C;
    }

    .form-group input[type="text"],
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 12px 16px;
      font-family: 'Montserrat', sans-serif;
      font-size: 14px;
      font-weight: 300;
      border: 1px solid #D9D2C7;
      border-radius: 3px;
      background-color: #FFFDF7;
      color: #2C2C2C;
      transition: border-color 0.2s;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: #C9A96E;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 80px;
    }

    .radio-group {
      display: flex;
      gap: 24px;
      margin-top: 4px;
    }

    .radio-group label {
      display: flex;
      align-items: center;
      gap: 8px;
      text-transform: none;
      letter-spacing: 0;
      font-size: 14px;
      font-weight: 300;
      cursor: pointer;
    }

    .radio-group input[type="radio"] {
      accent-color: #C9A96E;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      font-weight: 300;
      text-transform: none;
      letter-spacing: 0;
      cursor: pointer;
    }

    .checkbox-label input[type="checkbox"] {
      accent-color: #C9A96E;
    }

    #plus-one-fields {
      display: none;
      margin-top: 16px;
      padding: 24px;
      background-color: #FAF7F0;
      border-radius: 3px;
      border: 1px solid #E8E0D0;
    }

    #plus-one-fields .form-group:last-child {
      margin-bottom: 0;
    }

    #kids-section {
      display: none;
      margin-top: 16px;
      padding: 24px;
      background-color: #FAF7F0;
      border-radius: 3px;
      border: 1px solid #E8E0D0;
    }

    .kid-entry {
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid #E8E0D0;
    }

    .kid-entry:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .helper-text {
      font-size: 12px;
      color: #999;
      font-style: italic;
      margin-top: 8px;
    }
  </style>

  <form action="/rsvp" method="post" style="max-width: 500px; margin: 0 auto;">
    <% if @guest %>
      <input type="hidden" name="guest_code" value="<%= @guest[:code] %>">
    <% end %>
    <div class="form-group">
      <label for="name">Your Name</label>
      <% if @guest %>
        <input type="text" id="name" name="name" required value="<%= @guest[:name] %>" readonly style="background-color: #f0ede6; cursor: default;">
      <% else %>
        <input type="text" id="name" name="name" required placeholder="First and Last Name">
      <% end %>
    </div>

    <div class="form-group">
      <label>Will You Be Attending?</label>
      <div class="radio-group">
        <label><input type="radio" name="attending" value="yes" required checked> Joyfully Accept</label>
        <label><input type="radio" name="attending" value="no"> Regretfully Decline</label>
      </div>
    </div>

    <div id="attending-fields">
      <div class="form-group">
        <label for="meal_choice">Meal Preference</label>
        <select id="meal_choice" name="meal_choice">
          <option value="">Select a meal</option>
          <option value="chicken">Chicken</option>
          <option value="fish">Fish</option>
          <option value="vegetarian">Vegetarian</option>
        </select>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" id="plus_one" name="plus_one" onchange="togglePlusOne()">
          I will be bringing a plus one
        </label>
        <div class="helper-text">Note: Plus one is for an adult guest; use the kids section below for children under 18</div>
      </div>

      <div id="plus-one-fields">
        <div class="form-group">
          <label for="plus_one_name">Plus One's Name</label>
          <input type="text" id="plus_one_name" name="plus_one_name" placeholder="First and Last Name">
        </div>

        <div class="form-group">
          <label for="plus_one_meal_choice">Plus One's Meal Preference</label>
          <select id="plus_one_meal_choice" name="plus_one_meal_choice">
            <option value="">Select a meal</option>
            <option value="chicken">Chicken</option>
            <option value="fish">Fish</option>
            <option value="vegetarian">Vegetarian</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" id="has_kids" name="has_kids" onchange="toggleKids()">
          I will be bringing kids
        </label>
      </div>

      <div id="kids-section">
        <div id="kids-container"></div>
        <button type="button" onclick="addKid()" class="btn" style="width: 100%; background-color: #E8E0D0; color: #2C2C2C; margin-top: 16px;">Add Another Kid</button>
      </div>

      <div class="form-group">
        <label for="dietary_restrictions">Dietary Restrictions or Allergies</label>
        <textarea id="dietary_restrictions" name="dietary_restrictions" placeholder="Please let us know of any dietary needs..."></textarea>
      </div>
    </div>

    <button type="submit" class="btn" style="width: 100%; margin-top: 8px;">Submit RSVP</button>
  </form>
</div>

<script>
  var kidCount = 0;
  var MAX_KIDS = 10;

  function togglePlusOne() {
    var fields = document.getElementById('plus-one-fields');
    var checkbox = document.getElementById('plus_one');
    fields.style.display = checkbox.checked ? 'block' : 'none';
  }

  function toggleKids() {
    var section = document.getElementById('kids-section');
    var checkbox = document.getElementById('has_kids');

    if (checkbox.checked) {
      section.style.display = 'block';
      if (kidCount === 0) {
        addKid(); // Add first kid automatically
      }
    } else {
      section.style.display = 'none';
      // Clear all kids when unchecked
      document.getElementById('kids-container').innerHTML = '';
      kidCount = 0;
    }
  }

  function addKid() {
    if (kidCount >= MAX_KIDS) {
      alert('Maximum ' + MAX_KIDS + ' kids allowed');
      return;
    }

    var container = document.getElementById('kids-container');
    var kidDiv = document.createElement('div');
    kidDiv.className = 'kid-entry';
    kidDiv.dataset.kidIndex = kidCount;

    kidDiv.innerHTML =
      '<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">' +
        '<span style="font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 1.5px; color: #2C2C2C;">Kid ' + (kidCount + 1) + '</span>' +
        (kidCount > 0 ? '<button type="button" onclick="removeKid(this)" style="background: none; border: none; color: #c0392b; cursor: pointer; font-size: 12px;">Remove</button>' : '') +
      '</div>' +
      '<div class="form-group" style="margin-bottom: 12px;">' +
        '<label>Name</label>' +
        '<input type="text" name="kids[][name]" placeholder="Child\'s name" required>' +
      '</div>' +
      '<div class="form-group" style="margin-bottom: 0;">' +
        '<label>Meal Preference</label>' +
        '<select name="kids[][meal_choice]" required>' +
          '<option value="">Select a meal</option>' +
          '<option value="spaghetti-meatballs">Spaghetti + Meatballs</option>' +
          '<option value="mac-cheese-tenders">Butternut Mac + Cheese + Chicken Tenders</option>' +
          '<option value="cheeseburger">Ohio Beef Cheeseburger</option>' +
        '</select>' +
      '</div>';

    container.appendChild(kidDiv);
    kidCount++;
  }

  function removeKid(button) {
    var kidEntry = button.closest('.kid-entry');
    kidEntry.remove();
    kidCount--;

    // Renumber remaining kids
    var kids = document.querySelectorAll('.kid-entry');
    kids.forEach(function(kid, index) {
      var label = kid.querySelector('span');
      if (label) {
        label.textContent = 'Kid ' + (index + 1);
      }
    });
  }

  document.querySelectorAll('input[name="attending"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var fields = document.getElementById('attending-fields');
      var kidsCheckbox = document.getElementById('has_kids');
      var kidsSection = document.getElementById('kids-section');

      if (this.value === 'yes') {
        fields.style.display = 'block';
      } else {
        fields.style.display = 'none';
        // Uncheck and hide kids section when declining
        kidsCheckbox.checked = false;
        kidsSection.style.display = 'none';
        document.getElementById('kids-container').innerHTML = '';
        kidCount = 0;
      }
    });
  });
</script>
